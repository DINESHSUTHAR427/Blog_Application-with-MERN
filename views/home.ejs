<!DOCTYPE html>
<html lang="en">
<head>
    <%-  include('./partials/head.ejs')  %>
    <title>Home pages</title>
    <style>
        #particles-js {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color:rgb(0, 0, 0);
     
      z-index: -1;
    }

    h1 {
      position: relative;
      color: white;
      text-align: center;
      margin-top: 20%;
      font-size: 3rem;
    }

        .card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            overflow: hidden;
            background: rgba(15, 15, 20, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(138, 100, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.15);
        }
        .card-img-top {
            height: 200px;
            object-fit: cover;
            transition: transform 0.4s ease;
        }
        .card:hover .card-img-top {
            transform: scale(1.03);
        }
        .card-body {
            padding: 1.25rem;
        }
        .card-title {
            color: #f0f0f5 !important;
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 1rem;
            letter-spacing: 0.01em;
        }

        /* View Blog Button */
        .btn-view {
            display: block;
            width: 100%;
            padding: 10px 0;
            text-align: center;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            color: #fff;
            background: linear-gradient(135deg, #6c5ce7, #a855f7);
            border: none;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-transform: uppercase;
        }
        .btn-view:hover {
            background: linear-gradient(135deg, #7c6cf7, #b865ff);
            box-shadow: 0 4px 20px rgba(168, 85, 247, 0.4);
            transform: translateY(-1px);
            color: #fff;
            text-decoration: none;
        }

        /* Action Bar */
        .card-actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Edit Button */
        .btn-edit {
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 14px;
            font-size: 0.82rem;
            font-weight: 600;
            color: #a8e6cf;
            background: rgba(168, 230, 207, 0.1);
            border: 1px solid rgba(168, 230, 207, 0.2);
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .btn-edit:hover {
            background: rgba(168, 230, 207, 0.2);
            border-color: rgba(168, 230, 207, 0.4);
            box-shadow: 0 0 16px rgba(168, 230, 207, 0.15);
            color: #c8f6e0;
            text-decoration: none;
            transform: translateY(-1px);
        }
        .btn-edit svg {
            width: 14px;
            height: 14px;
        }

        /* Delete Button */
        .btn-delete {
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 14px;
            font-size: 0.82rem;
            font-weight: 600;
            color: #ff7675;
            background: rgba(255, 118, 117, 0.1);
            border: 1px solid rgba(255, 118, 117, 0.2);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-delete:hover {
            background: rgba(255, 118, 117, 0.22);
            border-color: rgba(255, 118, 117, 0.45);
            box-shadow: 0 0 16px rgba(255, 118, 117, 0.15);
            color: #ff9f9e;
            transform: translateY(-1px);
        }
        .btn-delete svg {
            width: 14px;
            height: 14px;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .card {
            animation: fadeInUp 0.5s ease forwards;
        }
        .col-md-4:nth-child(2) .card { animation-delay: 0.1s; }
        .col-md-4:nth-child(3) .card { animation-delay: 0.2s; }
        .col-md-4:nth-child(4) .card { animation-delay: 0.3s; }
        .col-md-4:nth-child(5) .card { animation-delay: 0.15s; }
        .col-md-4:nth-child(6) .card { animation-delay: 0.25s; }
    </style>
</head>
<body>
    <%-  include('./partials/nav.ejs')  %>
    <div id="particles-js"></div>
    <div class="container mt-4">
        <div class="row">
                <% blogs.forEach(blog => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div style="overflow:hidden;">
                                <img src="<%= blog.coverImageUrl %>" class="card-img-top" alt="blog image" loading="lazy">
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title"><%= blog.title%></h5>
                                <a href="/blog/<%= blog._id %>" class="btn-view mt-auto">View Blog</a>
                                <% if (user && blog.createdBy && blog.createdBy.toString() == user.id) { %>
                                    <div class="card-actions">
                                        <a href="/blog/edit/<%= blog._id %>" class="btn-edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            Edit
                                        </a>
                                        <form action="/blog/delete/<%= blog._id %>" method="POST" style="flex:1;display:flex;" onsubmit="return confirm('Are you sure you want to delete this blog?')">
                                            <button type="submit" class="btn-delete" style="width:100%;">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
        </div>
     </div>
     
    <%-include('./partials/scripte.ejs')  %>
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js" defer></script>
    <script src="/particles-config.js" defer></script>
</body>
</html>